{
    "name": "guarantee-type",
    "description": "guarantee the type of a plain object",
    "version": "0.2.13",
    "repository": "emilioplatzer/guarantee-type",
    "files": [
        "lib",
        "doc"
    ],
    "main": "lib/guarantee-type.js",
    "types": "lib/guarantee-type.d.ts",
    "scripts": {
        "build": "tsc -p src/lib",
        "test": "tsc -p src/lib && tsc -p src/test && mocha test-build-local/test/test*.js",
        "test-ci": "tsc -p src/lib && tsc -p src/test && c8 mocha test-build-local/test/test*.js",
        "test-wc": "mocha test-build-local/test/test",
        "preversion": "npm test",
        "version": "npm run build"
    },
    "c8": {
        "exclude": [
            "test-build-local/test",
            "src/test/**",
            "lib/**"
        ],
        "reporter": [
            "html",
            "lcov",
            "text-summary"
        ],
        "extension": [
            ".js",
            ".ts"
        ],
        "sourceMap": true,
        "instrument": true,
        "check-coverage": true
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.1.1",
        "expect.js": "^0.3.1",
        "mocha": "^12.0.0-rc.5",
        "c8": "^12.0.0",
        "qa-control": "^0.8.1",
        "typescript": "^5.9.2"
    },
    "qa-control": {
        "run-in": "both",
        "type": "lib",
        "coverage": 100,
        "gha": "all",
        "silenced": [
            "first_lines_does_not_match_in_file_1"
        ]
    }
}
